data/applications/**
!data/applications/*/
!data/applications/dna/promoters.data
*.zip
tools/spmf.jar

# Runtime, metrics & test outputs
results/
output/
output*.txt
*.tmp

# Python bytecode cache
__pycache__/
*.py[cod]

# Jupyter Notebook & IDE / OS files
.ipynb_checkpoints/
.vscode/
.DS_Store
Thumbs.db

# LaTeX build artifacts
*.aux
*.bbl
*.blg
*.fdb_latexmk
*.fls
*.log
*.out
*.synctex.gz
*.toc
